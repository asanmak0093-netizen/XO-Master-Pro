<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XO Master Pro"
        android:textColor="#E94560"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_score_x"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="X: 0"
            android:textColor="#FF1744"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_score_o"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="O: 0"
            android:textColor="#2979FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_turn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الدور: X"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#16213E"
        android:padding="4dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn00" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn01" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn02" style="@style/CellButton" />
        </LinearLayout>

        <View style="@style/DividerHorizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn10" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn11" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn12" style="@style/CellButton" />
        </LinearLayout>

        <View style="@style/DividerHorizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn20" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn21" style="@style/CellButton" />
            <View style="@style/DividerVertical" />
            <Button android:id="@+id/btn22" style="@style/CellButton" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="لعبة جديدة"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#E94560"
        android:textColor="#FFFFFF" />

</LinearLayout>
